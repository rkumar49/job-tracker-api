generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id        String   @id @default(cuid())
  company   String
  role      String
  status    String   @default("applied")
  url       String?
  notes     String?
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}